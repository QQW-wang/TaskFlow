# ===== 基础配置 =====
APP_NAME=TaskFlow API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ===== PostgreSQL =====
# 格式：postgresql+asyncpg://用户名:密码@主机:端口/数据库名
# 如果使用 docker-compose，默认就是下面的值。
DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@127.0.0.1:5432/taskflow
# 设置为 true 可以在控制台看到 SQL，排查问题时很有用。
SQL_ECHO=false

# ===== JWT =====
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ===== CORS =====
# 前端通过 python -m http.server 5500 启动，因此放行这两个本地地址。
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500